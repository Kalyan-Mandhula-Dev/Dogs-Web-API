{$DOMAIN} {
    handle /api/* {
        reverse_proxy dogs-api:8080
    }
    handle {
        reverse_proxy dogs-ui:80
    }
    handle /actuator/* {
        reverse_proxy dogs-api:8080
    }
    handle /logs* {
        basic_auth {
            {$LOGS_USER} {$LOGS_PASSWORD_HASH}
        }
        reverse_proxy dozzle:8080
    }
}